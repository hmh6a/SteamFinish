<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SteamFinish.Core</RootNamespace>
    <!-- Required by the LibraryImport source generator used for the power management calls. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Steam control channel is an implementation detail, but its wire handling is the part
         most worth testing against a stand-in DevTools endpoint. -->
    <InternalsVisibleTo Include="SteamFinish.Tests" />
  </ItemGroup>

</Project>
