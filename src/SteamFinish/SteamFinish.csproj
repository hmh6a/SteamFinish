<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms is referenced only for NotifyIcon, the system tray API. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SteamFinish</AssemblyName>
    <RootNamespace>SteamFinish</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>SteamFinish</Product>
    <Description>Shuts the PC down once Steam finishes downloading.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFO0003 asks WinForms apps to move DPI settings out of the manifest; this is a WPF app,
         where the manifest is the right place for them. Forms is only here for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <!-- Keep the WinForms implicit usings out of the way of the WPF types of the same name. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SteamFinish.Core\SteamFinish.Core.csproj" />
  </ItemGroup>

</Project>
