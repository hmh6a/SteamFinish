<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark palette. Same keys as Palette.Light.xaml, swapped wholesale at runtime. -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF0F151E" />
    <SolidColorBrush x:Key="CardBrush" Color="#FF19212D" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FF1E2735" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF283344" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#FF3A4759" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFE7EDF6" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF97A6BA" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF6D7C90" />

    <SolidColorBrush x:Key="AccentBrush" Color="#FF4BA3EA" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF6BB6F2" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FF16293C" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FF08121C" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#FF34C08A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFE0A63C" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFE5706B" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#FF49586B" />
    <SolidColorBrush x:Key="TrackBrush" Color="#FF232E3D" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FF354356" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FF4C5D73" />

    <!-- Launcher badge colours: Steam blue and Xbox green, brightened for a dark surface. -->
    <SolidColorBrush x:Key="PlatformSteamBrush" Color="#FF66C0F4" />
    <SolidColorBrush x:Key="PlatformSteamSoftBrush" Color="#FF14293B" />
    <SolidColorBrush x:Key="PlatformXboxBrush" Color="#FF6CC644" />
    <SolidColorBrush x:Key="PlatformXboxSoftBrush" Color="#FF152917" />
    <SolidColorBrush x:Key="HeaderSubtitleBrush" Color="#FF7FA8C8" />
    <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF121C27" Offset="0" />
        <GradientStop Color="#FF1E3547" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF66C0F4" Offset="0" />
        <GradientStop Color="#FF3E93DC" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SuccessBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF44D69A" Offset="0" />
        <GradientStop Color="#FF2AA875" Offset="1" />
    </LinearGradientBrush>

    <!-- Deeper and darker: on a dark surface a soft grey halo reads as fog, not as elevation. -->
    <DropShadowEffect x:Key="CardShadow" Color="#FF000000" BlurRadius="16"
                      ShadowDepth="3" Direction="270" Opacity="0.55" RenderingBias="Quality" />
    <DropShadowEffect x:Key="ButtonShadow" Color="#FF000000" BlurRadius="12"
                      ShadowDepth="2" Direction="270" Opacity="0.5" RenderingBias="Quality" />

</ResourceDictionary>
